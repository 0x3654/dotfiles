<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ночная копия Time Machine на micro (02:30). Автобэкапы выключены
         (tmutil disable, см. tasks/macos-timemachine.yml) — днём сеть не грузится.
         Если мак проспал 02:30, launchd доиграет запуск при пробуждении. -->
    <key>Label</key>
    <string>com.user.timemachine-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/tmutil</string>
        <string>startbackup</string>
        <string>--auto</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
</dict>
</plist>
